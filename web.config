<?xml version="1.0" encoding="UTF-8"?>
<!-- Line Pulse on IIS (26-11-2026): same rules as the .htaccess files of the Apache server (192.168.2.111).
     No folder listings; code, settings, data, tests and admin files are never served; the browser's security headers. -->
<configuration>
  <system.webServer>
    <directoryBrowse enabled="false" />
    <defaultDocument enabled="true">
      <files><clear /><add value="index.html" /></files>
    </defaultDocument>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments applyToWebDAV="true">
          <add segment="config" /><add segment="data" /><add segment="lib" /><add segment="tests" />
          <add segment="admin" /><add segment="sql" /><add segment="src" /><add segment="node_modules" />
          <add segment=".git" /><add segment="deploy" /><add segment="server" /><add segment="_to_delete" />
        </hiddenSegments>
        <fileExtensions allowUnlisted="true" applyToWebDAV="true">
          <add fileExtension=".ps1" allowed="false" /><add fileExtension=".bat" allowed="false" /><add fileExtension=".sh" allowed="false" />
          <add fileExtension=".md" allowed="false" /><add fileExtension=".sql" allowed="false" /><add fileExtension=".ini" allowed="false" />
          <add fileExtension=".bak" allowed="false" /><add fileExtension=".log" allowed="false" /><add fileExtension=".txt" allowed="false" />
          <add fileExtension=".zip" allowed="false" /><add fileExtension=".md5" allowed="false" /><add fileExtension=".key" allowed="false" />
          <add fileExtension=".pem" allowed="false" /><add fileExtension=".pfx" allowed="false" /><add fileExtension=".lock" allowed="false" />
          <add fileExtension=".indb" allowed="false" /><add fileExtension=".pending" allowed="false" /><add fileExtension=".env" allowed="false" />
          <add fileExtension=".pdf" allowed="false" /><add fileExtension=".conf" allowed="false" />
        </fileExtensions>
        <denyUrlSequences>
          <add sequence="package.json" /><add sequence="package-lock.json" /><add sequence="vite.config.js" />
          <add sequence="tailwind.config.js" /><add sequence="postcss.config.js" /><add sequence="/frontend/index.html" />
          <add sequence=".gitignore" /><add sequence=".htaccess" />
        </denyUrlSequences>
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
    <staticContent>
      <remove fileExtension=".woff" /><mimeMap fileExtension=".woff" mimeType="font/woff" />
      <remove fileExtension=".woff2" /><mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
  </system.webServer>
</configuration>
